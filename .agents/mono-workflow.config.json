      "target": "CHANGELOG.md",
      "heading": "## [Unreleased]"
    },
    "validation": {
      "check": "validate",
      "timeoutSec": 1800
    },
    "install": "wave-drain"
  },
  "issueOnlyLane": {
    "enabled": false
  },
