    "implementation": null,
    "ship": "gstack ship",
    "documentation": null,
    "reviewFeedback": "compound-engineering:ce-resolve-pr-feedback",
    "deploy": "gh merge, then landing-guard check on the merge SHA; install once per wave: landing-drain record/status/verify, node scripts/install-local.mjs --all-roots with --check, landing-drain close (skill-pack delivery)"
  },
  "deployApproval": "risky-only",
