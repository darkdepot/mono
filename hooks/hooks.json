{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|AskUserQuestion|request_user_input|request_user_input_async)$",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/window-guard.mjs\"", "timeout": 5 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/window-guard.mjs\"", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/window-guard.mjs\"", "timeout": 5 }] }
    ]
  }
}
